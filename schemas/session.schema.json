{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://los-alamos.local/schemas/session.schema.json",
  "title": "Los Alamos ResidencySession",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "projectTitle",
    "taskId",
    "taskTitle",
    "scope",
    "minutesPlanned",
    "intensity",
    "status",
    "startedAt",
    "prompt",
    "startAction",
    "completionCriteria",
    "notDoing",
    "selectionReason",
    "updatedAt",
    "updatedBy",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string" },
    "projectId": { "type": "string" },
    "projectTitle": { "type": "string" },
    "taskId": { "type": "string" },
    "taskTitle": { "type": "string" },
    "scope": { "enum": ["full_task", "checkpoint"] },
    "minutesPlanned": { "type": "number", "minimum": 1 },
    "intensity": { "enum": ["low", "medium", "high", "xhigh"] },
    "status": { "enum": ["proposed", "active", "paused", "closed", "cancelled"] },
    "startedAt": { "type": "string" },
    "endedAt": { "type": "string" },
    "prompt": { "type": "string" },
    "startAction": { "type": "string" },
    "completionCriteria": { "type": "string" },
    "notDoing": { "type": "string" },
    "selectionReason": { "type": "string" },
    "userResult": { "enum": ["completed", "not_completed", "partial"] },
    "userNote": { "type": "string" },
    "judgement": { "type": "string" },
    "log": { "type": "string" },
    "updatedAt": { "type": "string" },
    "updatedBy": { "enum": ["user", "app", "agent", "llm"] },
    "revision": { "type": "number", "minimum": 1 },
    "capsule": { "$ref": "capsule.schema.json" },
    "handoff": { "$ref": "capsule.schema.json" },
    "planId": { "type": "string" },
    "workDate": { "type": "string", "format": "date" },
    "elapsedSeconds": { "type": "number", "minimum": 0 },
    "lastResumedAt": { "type": "string", "format": "date-time" },
    "heartbeatAt": { "type": "string", "format": "date-time" },
    "pauseReason": { "type": "string" }
  }
}
