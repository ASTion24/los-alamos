{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://los-alamos.local/schemas/agent-context.schema.json",
  "title": "Los Alamos AgentContext",
  "type": "object",
  "required": [
    "protocolVersion",
    "phase",
    "summary",
    "workspace",
    "session",
    "constraints",
    "nextActions"
  ],
  "properties": {
    "protocolVersion": { "const": "1" },
    "phase": {
      "enum": [
        "repair_workspace",
        "needs_project",
        "needs_constraints",
        "ready_to_propose",
        "review_proposal",
        "residency_active",
        "residency_paused",
        "plan_attention",
        "no_eligible_task"
      ]
    },
    "summary": { "type": "string" },
    "workspace": {
      "type": "object",
      "required": ["root", "ok", "issues", "projects"],
      "properties": {
        "root": { "type": "string" },
        "ok": { "type": "boolean" },
        "plan": { "$ref": "plan.schema.json" },
        "inboxCount": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "code", "message", "path"],
            "properties": {
              "severity": { "enum": ["warning", "error"] },
              "code": { "type": "string" },
              "message": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "completionPercent", "archived"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "completionPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "archived": { "type": "boolean" }
            }
          }
        }
      }
    },
    "session": {
      "oneOf": [
        { "type": "null" },
        { "type": "object" }
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "minutes": {
          "type": "number",
          "minimum": 5,
          "maximum": 180
        },
        "intensity": {
          "enum": ["low", "medium", "high", "xhigh"]
        },
        "projectId": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "instruction"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": ["ask_user", "run_command", "wait_for_user"]
          },
          "instruction": { "type": "string" },
          "command": { "type": "string" },
          "requiresUserConfirmation": { "type": "boolean" }
        }
      }
    }
  }
}
