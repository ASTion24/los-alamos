{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://los-alamos.local/schemas/plan.schema.json",
  "title": "Los Alamos ResidencyPlan",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "projectIds", "startDate", "endDate", "dailyMinutes", "intensity", "notDoing", "exitCriteria", "status", "createdAt", "updatedAt", "updatedBy", "revision"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "projectIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "dailyMinutes": { "type": "number", "minimum": 5, "maximum": 480 },
    "intensity": { "enum": ["low", "medium", "high"] },
    "notDoing": { "type": "string", "minLength": 1 },
    "exitCriteria": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "committed", "active", "closed"] },
    "closingNote": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "enum": ["user", "app", "agent"] },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
